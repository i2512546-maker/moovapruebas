# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rapijob
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rapijob

# Auth
JWT_SECRET=change-me-to-a-256-bit-secret

# Cache
REDIS_URL=redis://localhost:6379

# Storage (S3 | cloudinary | local)
UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=eu-west-1
# S3_BUCKET=rapijob

# Comisión default (usada si no hay regla de specialty)
DEFAULT_COMMISSION_PCT=15.00

# Entorno
NODE_ENV=development
PORT=4000
